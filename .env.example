# Copy to .env(.local) and fill in. Gitignored — never commit real values.
#
# Vite reads VITE_* envs at build time; this is a Coolify-deployed TanStack
# Start (Nitro node-server) app — see Dockerfile for the matching ARG/ENV
# plumbing that actually gets these into the built bundle.

# Supabase project — shared with residale-crm (same project,
# vvtgwjjsvyyakpuficcq in production). Config's tables (floor_whisper_plans)
# live in the CRM migration tree and FK into CRM identity (members).
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Residale SSO (Google-like app switcher + shared session, DESIGN.md D1-D18)
# ---------------------------------------------------------------------------
# Default "true": the browser client stores its session in a shared
# `.residale.com` cookie so crm/webmail/files/config all see the same
# signed-in session with no relogin. Set to "false" to roll back to the
# legacy per-project storage key (sb-<ref>-auth-token) — the adapter seeds
# that legacy key from a still-present cookie once, so rollback loses no
# sessions.
VITE_RESIDALE_SSO_COOKIE_ENABLED=true

# Production hosts for the app switcher (Google-like grid menu). Override
# per environment (e.g. staging/preview URLs); defaults match production.
VITE_RESIDALE_APP_CRM_URL=https://crm.residale.com
VITE_RESIDALE_APP_WEBMAIL_URL=https://webmail.residale.com
VITE_RESIDALE_APP_FILES_URL=https://files.residale.com
VITE_RESIDALE_APP_CONFIG_URL=https://config.residale.com
